  "question": "L3t 分辨率登记表的每一行，登记的是不是该实验**判定时真正用的那个统计量**？据此把每条结论的「可引用强度」写成可执行的规范。",
  "why_now": "L3t 的 below_family_best 列出 5 条「效应量低于同族最好分辨率」，准备据此复盘引用口径；复核时发现 phasec_d 登记的是格 A 自己的 d_raw 水平（+0.014pp），而阶段 C 的主判定是 spread(B)−spread(A)（+1.9390pp, t=6.37），差 138 倍。若直接拿 L3t 做引用规范，会把一个 t=6.37 的结论写成「分辨率不足」。必须先核对口径，再谈分级。",

  "subject": {
    "path": "reports/gates/H-L3T-RESOLUTION/l3t_registry.json",
    "note": "被审计对象。本实验**不修改**该文件，更正以独立产物给出（R5：保留原始结果 + 出更正）"
  },

  "hardcoded": {
    "mde_coefficient": 2.8016,
    "nw_lag": 3,
    "min_n": 50,
    "note_n": "n < 50 的序列不参与 MDE 分级（沿用 L3t §2 的既定规则）"
  },

  "tolerance": {
    "mean_abs": 1e-06,
    "t_abs": 1e-04,
    "n_exact": true,
    "note": "mean 与 t 都按**绝对值**比较（方向由 effect 的符号单独记录，不靠容差）"
  },

  "match_classes": {
    "MATCH": "登记行与判定统计量在同一单位下 mean、t、n 全部在容差内一致",
    "MISMATCH_MEAN": "mean 或 t 越界（取了别的列 / 别的资金档 / 别的窗口）",
    "MISMATCH_N": "n 不一致（窗口或过滤不同）",
    "UNVERIFIABLE": "原产物缺失必要字段，无法核对（**不得**记为通过）"
  },

  "quotability_rules": {
    "principle": "「检出」类看效应量相对该设计 MDE 的倍数；「未检出」类看功效。两者不可互换——功效不足时『没检出』只能写成『无法判断』。",
    "detected_true": {
      "ratio_ge_2": "QUOTABLE",
      "ratio_1_to_2": "QUOTABLE_MARGINAL",
      "ratio_0.5_to_1": "DIRECTION_ONLY",
      "ratio_lt_0.5": "NOT_QUOTABLE"
    },
    "detected_false": {
      "power_ge_0.8": "NULL_CONFIRMED",
      "power_0.5_to_0.8": "NULL_WEAK",
      "power_lt_0.5": "UNDERPOWERED"
    },
    "ratio_definition": "|effect| / mde，两者同单位同分母（月度 pp / IC / %每折）",
    "power_definition": "Φ(|t|−1.96) + Φ(−|t|−1.96)，与 L3r/L3s 同式",
    "not_classified": "n < min_n 或为 MISMATCH_* / UNVERIFIABLE 的条目不下分级结论"
  },

  "verdict_semantics": {
    "negative_markers": ["NOT_DETECTED", "NOT_EXECUTABLE", "FAILURE", "failure", "ABSORBED", "INSUFFICIENT", "NEGLIGIBLE", "BLOCKED", "INCONCLUSIVE", "REJECTED"],
    "positive_markers": ["CONFIRMED", "SUCCESS", "DETECTED", "SIGNIFICANT", "EXECUTABLE", "FRAGILE", "SENSITIVE", "DEPENDENT"],
    "rule": "先查 negative_markers（任一命中即 detected=false），再查 positive_markers；两者都不含则 detected=null 并记 UNCLASSIFIED——不得默认成任一边",
    "known_trap": "phaseq 的 MAX5 判定原文是 INCREMENTAL_ABSORBED（吸收＝未检出），L3t 表里写成 MAX5_INCREMENTAL（听起来像成立）。这条规则要求按原文匹配，不按记忆"
  },

