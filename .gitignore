# ============================================================
# DeepQuant .gitignore
# 原则：本地数据、虚拟环境、密钥一律不入 Git
# ============================================================

# ---------- Python 虚拟环境 / 缓存 ----------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 本地行情数据（原始 / 处理后分开保存，但不入库）----------
# 保留目录结构（.gitkeep），忽略目录内实际数据文件
/data/raw/*
/data/processed/*
/data/metadata/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/data/metadata/.gitkeep

# Step 7.5 起新增的研究数据目录（如 data/step75/*.qfq.csv）
# 必须以 / 开头锚定仓库根目录；写成 data/**/*.csv 会误伤 backend/tests/data 下的测试夹具
/data/**/*.csv

# ---------- 例外：样本外检验的可复现基线（2026-10-19 用户批准入库）----------
# 为什么破例：OOS 检验按 sha256 锁定数据指纹，`scripts/oos_2026_run.py` 第一步就校验。
# 数据不入库 → 换机后第一步必退出，且腾讯 qfq 以最新价为基准重下后哈希大概率改变，
# 届时只能当"新检验"重跑，无法声称复现。这两个目录合计约 1.5 MB，是检验本身的一部分。
# 仍然只放行这两个精确路径；data/step75 等其余行情目录维持不入库。
!/data/step75_ext/
!/data/step75_ext/*.csv
!/data/benchmark/
!/data/benchmark/*.csv

# 例外：样本外结果重算的数据池（2026-10-19）
# 为什么破例：重算预登记按 sha256 锁定这 6 个文件（见 docs/OOS_RECALC_PREREG_V1.1_2026-10-19.sha256）。
# 数据不入库，别人就无法验证"跑的是不是这一份"，sha256 锁就成了自证。
# 乘性口径的完整目录 data/qfq_mult/（302 只）仍然不入库，这里只放检验用到的那 6 只（约 0.8 MB）。
!/data/oos_recalc_pool_2017/
!/data/oos_recalc_pool_2017/*.csv

# 常见数据文件后缀，防止误提交到其他位置
*.parquet
*.sqlite
*.sqlite3
*.db
# SQLite 运行时伴随文件（WAL / SHM / journal），不得入库
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db-wal
*.db-shm
*.db-journal
*.sqlite-journal
*.sqlite3-journal

# API 服务默认数据根（backend/data/，可由 DEEPQUANT_DATA_ROOT 覆盖）：本地行情同样不入库
/backend/data/

# ---------- 密钥与环境变量（安全要求）----------
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ---------- Node / 前端（第一阶段暂未启用，先预留）----------
node_modules/
dist/
.vite/
*.log

# ---------- 编辑器 / 操作系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------- 本地运行产物 / 代理记忆 ----------
backend/data/
backend/data/**
.workbuddy/
probe_out/*.log
/data/raw/
/data/oos_recalc_pool*/

# T3 依赖状态（切换事件与延迟档案）：运行时产物，不入库
/backend/data/deps/

# T5 安全状态（熔断状态与清理证据）：运行时产物，不入库
/backend/data/safety/

# ---------- 分红与行情原始数据（2026-11-03 补：曾误将 12,171 个 json 暂存）----------
# div_all_em/div_all_sina 每只股票一个 json（合计 10,930 个），exec/exec_all/qfq_all 为行情。
# 原则不变：数据不入 Git，靠 migrate_data.py 清单 + 云主机备份 + 每周邮件包保全。
# 一旦入库，git 会把 1.67 GB 二进制历史永久留在 .git 里，且 clone/push 全部变慢。
/data/div_all_em/
/data/div_all_sina/
/data/exec/
/data/exec_all/
/data/qfq_all/
/data/qfq_all_prev_*/
/data/_backup_*/
/data/_all_a_*.txt
/data/_all_a_*manifest.json
