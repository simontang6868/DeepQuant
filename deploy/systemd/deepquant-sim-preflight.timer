[Unit]
Description=DeepQuant PREFLIGHT timer (11-30 18:00 one-shot)
# 施工单 A1 写"12-02 后 09:20"，但 §1 把 PREFLIGHT 定在 11-30 18:00 且出证后才有 M-1201-PREDICT。
# 按 §1 的演练前置时点落地；12-02 版未建（演练后再说），冲突已登记在交付报告。

[Timer]
OnCalendar=2026-11-30 18:00:00
Persistent=false
AccuracySec=1s
Unit=deepquant-sim-preflight.service

[Install]
WantedBy=timers.target
