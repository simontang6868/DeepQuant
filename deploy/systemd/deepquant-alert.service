[Unit]
Description=DeepQuant heartbeat alert (in-machine check)
After=deepquant-daily.service

[Service]
Type=oneshot
User=deepquant
Group=deepquant
WorkingDirectory=__REPO__
EnvironmentFile=__REPO__/env
Environment=HOME=/home/deepquant
ExecStart=__REPO__/.venv/bin/python __REPO__/deploy/bin/heartbeat_alert.py
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deepquant-alert

[Install]
WantedBy=multi-user.target
