[Unit]
Description=DeepQuant P1 alert (email same-day: fill rate / slippage / reconcile diff)

[Service]
Type=oneshot
User=deepquant
Group=deepquant
WorkingDirectory=__REPO__
EnvironmentFile=__REPO__/env
Environment=HOME=/home/deepquant
ExecStart=/bin/bash -lc 'set -a; . __REPO__/env; set +a; cd __REPO__; __REPO__/.venv/bin/python -u scripts/probe_automation.py alert --level P1 --card research/stock_pick_2026-10-25/forward/alert_cards/P1_FILL_SLIP.md --id unit_%n'
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deepquant-alert-p1

[Install]
WantedBy=multi-user.target
