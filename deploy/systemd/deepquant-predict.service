[Unit]
Description=DeepQuant M-1201-PREDICT (11-30 after corroboration) -> arm sim timers only if 6/6
OnFailure=deepquant-alert-p0.service

[Service]
Type=oneshot
# systemctl enable 需要 root；本单元只做 enable 与写记录，不做任何下单/改判据
User=root
WorkingDirectory=__REPO__
EnvironmentFile=__REPO__/env
ExecStart=/bin/bash -lc 'set -a; . __REPO__/env; set +a; cd __REPO__; __REPO__/.venv-gm/bin/python -u scripts/probe_automation.py predict'
TimeoutStartSec=1000
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deepquant-predict

[Install]
WantedBy=multi-user.target
