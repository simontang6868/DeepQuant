[Unit]
Description=DeepQuant trading calendar refresh (monthly)

[Service]
Type=oneshot
User=deepquant
Group=deepquant
WorkingDirectory=__REPO__/research/stock_pick_2026-10-25/scripts/sp5
EnvironmentFile=__REPO__/env
Environment=HOME=/home/deepquant
# 只刷新"日历"，不碰任何决策。日历拿不到时脚本自己会失败，写不进坏文件。
ExecStart=__REPO__/.venv/bin/python trade_calendar.py --refresh
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deepquant-calendar

[Install]
WantedBy=multi-user.target
