# DeepQuant 云主机环境变量（复制为 /opt/deepquant/env，chmod 600）
#
# ⚠️ 本文件**不含任何凭证**，也不应该包含：
#    这台机器是证据引擎，不下单、不接券商、没有交易权限。
#    如果哪天有人往这里加券商账号，说明有人误解了这台机器的用途——停下来核对。
#
# 格式要求：systemd EnvironmentFile 不支持引号包裹与换行，一行一个 KEY=VALUE。

# 仓库根目录
DEEPQUANT_HOME=/opt/deepquant

# 虚拟环境解释器（bootstrap.sh 会创建）
DEEPQUANT_PYTHON=/opt/deepquant/.venv/bin/python

# ---- 机外备份（二选一，都不填则备份脚本会失败退出）----
# 这是**有意的**：备份配错了却每次成功退出，是最危险的形态。
# DEEPQUANT_BACKUP_RSYNC=backup@10.0.0.5:/srv/deepquant-backup
# DEEPQUANT_BACKUP_RCLONE=myremote:deepquant-backup
DEEPQUANT_BACKUP_KEEP_DAYS=30

# ---- 外部心跳（强烈建议；不填则整机故障无人知晓）----
# 在 healthchecks.io（或其他同类服务）建一个每日检查，周期设 1 天、宽限 3 小时，
# 把它的 ping URL 填在这里。daily_chain.sh 每天结束时会请求它。
# DEEPQUANT_HEARTBEAT_PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# ---- 机内告警的通知通道（可选）----
# 支持任意接受 {"text": "..."} JSON POST 的 webhook（企业微信机器人 / Slack / Bark 等）。
# 不填则只在 journald 里留 [ALERT]，需要人去看——这不算"已通知"。
# DEEPQUANT_ALERT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
